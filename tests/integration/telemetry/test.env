# Variáveis de interpolação para a stack de integração de telemetria.
#
# Reusa o compose real em deploy/docker-compose.yml (base) com um override
# mínimo em docker-compose.override.yml. Este arquivo apenas satisfaz as
# variáveis obrigatórias (`:?`) do compose base e define credenciais de
# teste determinísticas. NÃO use em produção.

# --- Plano de controle (serviços não iniciados, mas o compose exige) ---
POSTGRES_USER=linx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linx
CHIRPSTACK_HOST=localhost:8080
CHIRPSTACK_API_TOKEN=test-token
SERVICE_TOKEN=test-token
# Interpolacao do compose exige (agent_bridge/client_agent, #207); servicos
# nao sobem na stack de telemetria, mas o `:?` roda na interpolacao.
AGENT_SERVICE_TOKEN=it-agent-service-token-not-in-prod-32ch
# Canal gRPC core<->agent (#207) — valor de teste, >=32 chars, nao-placeholder.
AGENT_SERVICE_TOKEN=it-integration-agent-token-not-prod-32
RABBITMQ_ADMIN_USER=linx
RABBITMQ_ADMIN_PASSWORD=changeme
RABBITMQ_TENANT_SECRET=changeme
RABBITMQ_TENANT_PASS=changeme
RABBITMQ_AMQP_HOST=rabbitmq:5672
RABBITMQ_VHOST=/

# --- Tenant / TimescaleDB ---
DB_USER=tenant
DB_PASSWORD=changeme
DB_NAME=tenantdb

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=linx
RABBITMQ_DEFAULT_PASS=changeme

# --- Telemetria ---
APP_ID=integration-app
MQTT_TOPIC=application/+/device/+/event/up
RABBIT_EXCHANGE_PREFIX=linx.telemetry
