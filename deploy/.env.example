# Stack unificada (deploy/docker-compose.yml).
# Copie para `.env` (`cp .env.example .env`) e ajuste os valores.
# O `.env` é ignorado pelo git — nunca versione credenciais reais.

# --- Banco do plano de controle (serviço `db`) ---
POSTGRES_USER=linx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linx

# Ambiente do identity_api. Em `production` o Swagger/OpenAPI (/docs,
# /openapi.json) fica desabilitado. O compose de produção usa `production`
# por padrão; altere apenas para staging/dev controlados.
ENVIRONMENT=production

# --- Banco do tenant / TimescaleDB (serviços `timescaledb` e `telemetry_consumer`) ---
DB_USER=tenant
DB_PASSWORD=changeme
DB_NAME=tenantdb

# --- ChirpStack (Network Server consumido pelo identity_api via gRPC) ---
# Host:porta do ChirpStack alcançável pelo identity_api (não usar localhost
# dentro do container; aponte para o host onde o ChirpStack roda).
CHIRPSTACK_HOST=localhost:8080
# Token de API do ChirpStack (Bearer). Obrigatório no startup do identity_api.
CHIRPSTACK_API_TOKEN=changeme

# Token de serviço compartilhado para chamadas service-to-service.
# Protege todo o plano de controle (tenants, applications, devices, profiles
# e usuários) via header X-Service-Token. Obrigatório e com no mínimo 32
# caracteres; placeholders conhecidos são rejeitados no startup.
SERVICE_TOKEN=changeme
# Token do canal gRPC core<->agent (agent_bridge exige desde #207; >=32 chars,
# sem placeholder). Compartilhado entre agent_bridge e client_agent.
AGENT_SERVICE_TOKEN=dev-agent-service-token-not-in-prod-32chars

# --- Comunicação entre serviços (nomes de serviço do Compose, não localhost) ---
# Endereço gRPC do agent_bridge alcançável pelo client_agent.
SAAS_GRPC_HOST=agent_bridge:50051
GRPC_TIMEOUT_SECONDS=5
CONFIG_CACHE_TTL_SECONDS=60

# --- Telemetry consumer ---
# APP_ID: UUID v4 da application cadastrada no identity_api (o mesmo retornado
# pelo ChirpStack). Define o exchange `linx.telemetry.{APP_ID}`, a fila
# `linx.telemetry.{APP_ID}` e o binding `application.{APP_ID}.#`.
APP_ID=
# Tópico MQTT de uplink consumido pelo routing.
MQTT_TOPIC=application/+/device/+/event/up

# --- RabbitMQ (serviço `rabbitmq`) ---
# Credenciais do usuário padrão (administrativo) do broker. O `routing` e o
# provisionamento do identity_api usam essas credenciais.
# RABBITMQ_DEFAULT_PASS é obrigatória no `docker compose` (falha se ausente).
RABBITMQ_DEFAULT_USER=linx
RABBITMQ_DEFAULT_PASS=changeme

# --- RabbitMQ: provisionamento por tenant (identity_api) ---
# Management API usada para criar o usuário/permissões de cada aplicação.
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_ADMIN_USER=linx
RABBITMQ_ADMIN_PASSWORD=changeme
RABBITMQ_VHOST=/
# Host AMQP usado para montar o RABBIT_URL do tenant.
RABBITMQ_AMQP_HOST=rabbitmq:5672
# Chave HMAC da senha determinística do usuário de tenant. Troque em produção.
RABBITMQ_TENANT_SECRET=changeme
# Senha derivada de APP_ID+RABBITMQ_TENANT_SECRET (rode
# deploy/scripts/provision-rabbitmq-tenant.sh). Usada apenas pelo
# telemetry_consumer local para montar o RABBIT_URL com a credencial do tenant.
RABBITMQ_TENANT_PASS=

# --- Routing service (uplink MQTT -> exchange RabbitMQ `topic`) ---
# O broker Mosquitto pertence ao stack infra e é alcançado pela rede
# `linx-network` (#188). Suba o infra antes do deploy.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Credencial de leitura do routing no broker do infra. Deve bater com
# `MQTT_ROUTING_USER`/`MQTT_ROUTING_PASSWORD` de infra/.env e com o
# mosquitto.acl versionado em infra/configuration/mosquitto/config/.
MQTT_ROUTING_USER=routing
MQTT_ROUTING_PASSWORD=routing-dev-change-me
# URL AMQP do RabbitMQ publicado pelo serviço `rabbitmq`.
# Se a senha tiver caracteres especiais (@, :, /, ?...), faça o URL-encode
# (ex.: `p@ss` vira `p%40ss`) para não quebrar o parser da URL.
RABBIT_URL=amqp://${RABBITMQ_DEFAULT_USER:-linx}:${RABBITMQ_DEFAULT_PASS:-linx}@rabbitmq:5672/%2f
# Exchange RabbitMQ base: cada tenant publica/consome em
# `{RABBIT_EXCHANGE_PREFIX}.{APP_ID}`.
RABBIT_EXCHANGE_PREFIX=linx.telemetry
# Fila durável de auditoria com binding `#`; evita descarte silencioso quando
# não há consumidor ligado ao exchange.
RABBIT_AUDIT_QUEUE=linx.telemetry.audit

# --- TLS (nginx self-signed) ---
# Host usado como CN/SAN do certificado gerado por
# scripts/gen-self-signed-cert.sh. Pode ser um hostname ou um IP; se for um IP
# literal, o script o adiciona como IP SAN. Use o IP público ou o hostname da
# EC2 para que o curl/browser acessem sem erro de nome; "localhost" (default)
# serve para testes na própria máquina.
TLS_CERT_HOST=localhost

CHIRPSTACK_DEVICE_PROFILE_ID=

# --- Deprovisionamento Docker (opcional) ---
# O stack deploy não inclui o docker_provisioner. Deixe vazio para permitir
# excluir aplicações sem depender do Docker. Preencha com
# docker_provisioner:50052 ao adicionar o provisioner ao stack.
PROVISIONER_GRPC_HOST=
PROVISIONER_GRPC_TIMEOUT_SECONDS=10
