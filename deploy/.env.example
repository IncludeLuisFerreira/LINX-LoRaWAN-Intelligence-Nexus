# Stack unificada (deploy/docker-compose.yml).
# Copie para `.env` (`cp .env.example .env`) e ajuste os valores.
# O `.env` é ignorado pelo git — nunca versione credenciais reais.

# --- Banco do plano de controle (serviço `db`) ---
POSTGRES_USER=linx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linx

# --- Banco do tenant / TimescaleDB (serviços `timescaledb` e `tenant_app`) ---
DB_USER=tenant
DB_PASSWORD=changeme
DB_NAME=tenantdb

# --- ChirpStack (Network Server consumido pelo identity_api via gRPC) ---
# Host:porta do ChirpStack alcançável pelo identity_api (não usar localhost
# dentro do container; aponte para o host onde o ChirpStack roda).
CHIRPSTACK_HOST=localhost:8080
# Token de API do ChirpStack (Bearer). Obrigatório no startup do identity_api.
CHIRPSTACK_API_TOKEN=changeme

# --- Comunicação entre serviços (nomes de serviço do Compose, não localhost) ---
# Endereço gRPC do agent_bridge alcançável por client_agent e tenant_app.
SAAS_GRPC_HOST=agent_bridge:50051
# Destino do encaminhamento de telemetria do client_agent para o tenant_app.
TENANT_APP_URL=http://tenant_app:8002
# Endereço do middleware compartilhado visto pelo tenant_app.
CLIENT_AGENT_URL=http://client_agent:8001
GRPC_TIMEOUT_SECONDS=5
CONFIG_CACHE_TTL_SECONDS=60

# --- Tenant app ---
# APP_ID: UUID v4 da application cadastrada no identity_api.
APP_ID=
# Tópico MQTT de uplink consumido pelo tenant_app.
MQTT_TOPIC=application/+/device/+/event/up

# --- Routing service (uplink MQTT -> device_routes -> Client Agent) ---
# Broker MQTT de onde o serviço de roteamento consome os uplinks.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
# Timeout do POST de encaminhamento ao agent_endpoint do Client Agent.
HTTP_TIMEOUT_SECONDS=5

# --- Porta publicada do tenant_app no host ---
# O container sempre escuta em 8002; esta variável só muda a porta do host.
TENANT_PORT=8002

# --- TLS (nginx self-signed) ---
# Host usado como CN/SAN do certificado gerado por
# scripts/gen-self-signed-cert.sh. Pode ser um hostname ou um IP; se for um IP
# literal, o script o adiciona como IP SAN. Use o IP público ou o hostname da
# EC2 para que o curl/browser acessem sem erro de nome; "localhost" (default)
# serve para testes na própria máquina.
TLS_CERT_HOST=localhost
