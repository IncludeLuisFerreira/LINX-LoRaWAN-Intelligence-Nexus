VITE_ENABLE_MOCKS=false
# Token de serviço injetado nos proxies /api e /ws do dev server (npm run dev).
# O WebSocket precisa dele no handshake porque o browser não consegue enviar
# headers em conexões WebSocket. Só usado em desenvolvimento; em produção o
# nginx do dashboard injeta o header server-side. Nunca use o mesmo token de
# produção aqui.
DEV_SERVICE_TOKEN=
