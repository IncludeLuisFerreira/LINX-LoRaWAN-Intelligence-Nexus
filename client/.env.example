# Conexão com o RabbitMQ (exchange de telemetria).
# Em dev na mesma máquina, amqp://guest:guest@localhost:5672/%2f; dentro do
# docker-compose use o serviço "rabbitmq".
RABBIT_URL=amqp://guest:guest@localhost:5672/%2f
APP_ID=app-abc123

# Conexão com o TimescaleDB (dentro do docker-compose use "timescaledb").
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=tenant
DB_PASSWORD=changeme
DB_NAME=tenantdb

# Bind do servidor HTTP.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Frontend (dashboard). URL base do backend usada pelo proxy /api do nginx.
# No stack unificado aponte para o identity_api (ex.: http://identity_api:8000).
BACKEND_URL=http://identity_api:8000
# Token de serviço do plano de controle. O nginx do dashboard o injeta no
# header X-Service-Token do proxy /api; o browser nunca o vê. Use o mesmo
# valor do SERVICE_TOKEN do identity_api.
SERVICE_TOKEN=changeme
# Destino do proxy /ws do nginx (WebSocket de telemetria do telemetry_consumer).
WS_BACKEND_URL=http://telemetry_consumer:8000
# Liga os mocks (MSW) no build do dashboard; use true para demo sem backend.
VITE_ENABLE_MOCKS=false
