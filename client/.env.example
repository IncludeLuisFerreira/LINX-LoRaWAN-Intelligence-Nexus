# Endereço do middleware compartilhado (middleware/services/client_agent).
# Em dev na mesma máquina, http://localhost:8001; dentro do container use um
# endereço alcançável (IP do host ou rede Docker compartilhada).
CLIENT_AGENT_URL=http://localhost:8001
APP_ID=app-abc123
MQTT_TOPIC=au915_0/gateway/+/event/up
TENANT_PORT=8002
DB_USER=tenant
DB_PASSWORD=changeme
DB_NAME=tenantdb

# Conexão gRPC com o Linx Core (GetAppConfig no startup).
# Em dev na mesma máquina, localhost:50051; dentro do container use um
# endereço alcançável (IP do host ou rede Docker compartilhada).
SAAS_GRPC_HOST=localhost:50051

# Conexão com o TimescaleDB (dentro do docker-compose use "timescaledb").
DB_HOST=timescaledb
DB_PORT=5432
