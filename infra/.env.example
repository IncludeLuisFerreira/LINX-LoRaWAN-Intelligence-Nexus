# Credenciais MQTT do broker Mosquitto (issue #208 — allow_anonymous false).
# Copie para `infra/.env` (`cp .env.example .env`) e ajuste. O `.env` é
# ignorado pelo git — NUNCA versione senhas/hashes reais.
#
# TLS (#81): antes de subir a stack, gere CA e certificado do servidor com
# `infra/scripts/gen-mosquitto-certs.sh`. O listener é somente 8883 (tls);
# a 1883 plaintext foi removida. `MQTT_TLS_HOST` controla o host extra no SAN
# do certificado (default `mosquitto`, nome do serviço no Compose); use o IP
# público/hostname quando os clientes conectarem de fora do Docker.
# MQTT_TLS_HOST=mosquitto
#
# Os nomes de usuário devem bater com `configuration/mosquitto/config/
# mosquitto.acl`. Os valores abaixo são DEFAULTS DE DEV — troque em produção.
# O `mosquitto.passwd` real é gerado pelo serviço `mosquitto-init` do compose
# (a partir destas env vars) ou por `scripts/gen-mosquitto-passwd.sh`; não é
# versionado.

# Identidade do ChirpStack (integration MQTT + gateway backend + bridge):
# readwrite application/# e readwrite au915_0/# (ACL).
MQTT_CHIRPSTACK_USER=chirpstack
MQTT_CHIRPSTACK_PASSWORD=chirpstack-dev-change-me

# Identidade do serviço de roteamento (somente SUBSCRIBE em application/#):
MQTT_ROUTING_USER=routing
MQTT_ROUTING_PASSWORD=routing-dev-change-me

# Identidade do healthcheck do broker (read $SYS/broker/uptime):
MQTT_HEALTHCHECK_USER=healthcheck
MQTT_HEALTHCHECK_PASSWORD=healthcheck-dev-change-me

# Senha do PostgreSQL do ChirpStack (stack infra).
# Obrigatória: `infra/docker-compose.yml` falha se ausente.
POSTGRES_PASSWORD=chirpstack-dev-change-me

# --- RabbitMQ do stack base (broker único) ---
# O compose lê este arquivo porque o projeto está em `infra/`.
# Os mesmos valores devem existir em `linx_core/.env` (e em `deploy/.env`,
# enquanto esse stack existir), nas variáveis RABBITMQ_ADMIN_USER e
# RABBITMQ_ADMIN_PASSWORD.
RABBITMQ_ADMIN_USER=linx
RABBITMQ_ADMIN_PASSWORD=change-me-in-production

# --- Portas publicadas no host ---
# O broker e o Mosquitto escutam apenas em loopback. A suíte de integração
# sobrescreve estas portas em tests/integration/telemetry/test.env.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
MQTT_HOST_PORT=1883
