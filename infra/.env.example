# Credenciais MQTT do broker Mosquitto (issue #208 — allow_anonymous false).
# Copie para `infra/.env` (`cp .env.example .env`) e ajuste. O `.env` é
# ignorado pelo git — NUNCA versione senhas/hashes reais.
#
# Os nomes de usuário devem bater com `configuration/mosquitto/config/
# mosquitto.acl`. Os valores abaixo são DEFAULTS DE DEV — troque em produção.
# O `mosquitto.passwd` real é gerado pelo serviço `mosquitto-init` do compose
# (a partir destas env vars) ou por `scripts/gen-mosquitto-passwd.sh`; não é
# versionado.

# Identidade do ChirpStack (integration MQTT + gateway backend + bridge):
# readwrite application/# e readwrite au915_0/# (ACL).
MQTT_CHIRPSTACK_USER=chirpstack
MQTT_CHIRPSTACK_PASSWORD=chirpstack-dev-change-me

# Identidade do serviço de roteamento (somente SUBSCRIBE em application/#):
MQTT_ROUTING_USER=routing
MQTT_ROUTING_PASSWORD=routing-dev-change-me

# Identidade do healthcheck do broker (read $SYS/broker/uptime):
MQTT_HEALTHCHECK_USER=healthcheck
MQTT_HEALTHCHECK_PASSWORD=healthcheck-dev-change-me
