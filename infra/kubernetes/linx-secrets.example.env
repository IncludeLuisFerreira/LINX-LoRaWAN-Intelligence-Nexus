# Template de segredos para o namespace linx (Entrega 3, issue #257).
# NAO commitar valores reais. Copie para linx-secrets.env, preencha, e crie:
#
#   kubectl create secret generic linx-secrets -n linx --from-env-file=infra/kubernetes/linx-secrets.env
#
# Os serviços rejeitam placeholders no startup (linx_shared/core/config.py:
# require_secret / require_connection_string). Valores abaixo sao proibidos em
# producao e servem apenas para deixar claro quais chaves o Secret precisa ter.

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

# Host interno do Postgres no cluster (ver infra/kubernetes/base/postgres.yaml).
DATABASE_URL=postgresql+psycopg://change-me:change-me@postgres.linx.svc.cluster.local:5432/change-me

SERVICE_TOKEN=change-me
AGENT_SERVICE_TOKEN=change-me
CHIRPSTACK_API_TOKEN=change-me
RABBITMQ_ADMIN_USER=change-me
RABBITMQ_ADMIN_PASSWORD=change-me
RABBITMQ_TENANT_SECRET=change-me

# URL AMQP completa consumida pelo jobs_worker (issue #273). Substitua por
# credenciais reais antes do apply; o worker rejeita placeholders no startup.
RABBITMQ_AMQP_URL=amqp://change-me:change-me@rabbitmq.linx.svc.cluster.local:5672/
