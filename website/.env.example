# Integração Auth0 do site LINX (website/).
# Copie para `.env` (`cp .env.example .env`) e preencha com os dados do tenant.
# O `.env` é ignorado pelo git — nunca versione credenciais reais.

# --- Auth0 ---
# Domínio do tenant, sem esquema. Ex.: linx.us.auth0.com
AUTH0_DOMAIN=seu-tenant.us.auth0.com
# Application do tipo "Regular Web Application" no Auth0.
AUTH0_CLIENT_ID=seu-client-id
AUTH0_CLIENT_SECRET=seu-client-secret
# API/Audience opcional (usada pelo backend numa fase futura).
AUTH0_AUDIENCE=
# Escopos solicitados no login.
AUTH0_SCOPE=openid profile email

# --- URLs e sessão ---
# Caminho same-origin para onde o usuário volta após o login (padrão: /).
# A sessão do website NÃO é compartilhada com o app da plataforma.
POST_LOGIN_REDIRECT=/
# URL pública do site (usada no callback e no logout).
SITE_URL=http://localhost:4321
# Chave forte (>= 32 caracteres) para criptografar o cookie de sessão.
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais
