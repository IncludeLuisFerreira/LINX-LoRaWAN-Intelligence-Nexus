---
/**
 * Layout base do site.
 * Envolve todas as páginas: injeta metadata, fontes, CSS global, link de
 * acessibilidade ("pular para o conteúdo") e o <slot /> das páginas.
 * O script de movimento no fim é global (reveals, contadores, tilt).
 */
import '../styles/global.css';

interface Props {
  /** Título da aba do navegador. */
  title?: string;
  /** Descrição usada por buscadores (SEO) e compartilhamento. */
  description?: string;
}

const {
  title = 'LINX — Sensores conectados. Infraestrutura zero.',
  description =
    'A LINX conecta seus sensores LoRaWAN à nuvem com segurança e provisionamento por QR Code. Sem gateways no seu site, sem servidores para manter.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f33" />

    <!-- Geist + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Acessibilidade: permite pular a navegação direto para o conteúdo -->
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <slot />

    <script>
      /**
       * Movimento global (roda só no navegador).
       * 1. Reveals em cascata (IntersectionObserver).
       * 2. Contadores animados ao entrar na tela.
       * 3. Tilt + spotlight nos cards com [data-tilt].
       * Tudo desligado quando o usuário pede menos movimento.
       */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveals
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        revealEls.forEach((el, i) => {
          // cascata automática quando não há delay explícito
          if (!el.style.getPropertyValue('--reveal-delay') && i % 3 !== 0) {
            el.style.setProperty('--reveal-delay', `${(i % 4) * 90}ms`);
          }
          io.observe(el);
        });
      }

      // 2. Contadores
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const runCounter = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.count || '0');
        const decimals = parseInt(el.dataset.decimals || '0', 10);
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const fmt = (v: number) =>
          v.toLocaleString('pt-BR', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });
        if (reduce) {
          el.textContent = prefix + fmt(target) + suffix;
          return;
        }
        const dur = 1400;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + fmt(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (counters.length) {
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              runCounter(entry.target as HTMLElement);
              cio.unobserve(entry.target);
            });
          },
          { threshold: 0.4 },
        );
        counters.forEach((el) => cio.observe(el));
      }

      // 3. Tilt + spotlight
      if (!reduce && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', `${px * 100}%`);
            card.style.setProperty('--my', `${py * 100}%`);
            card.style.transform = `perspective(900px) rotateX(${(0.5 - py) * 6}deg) rotateY(${(px - 0.5) * 6}deg)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
