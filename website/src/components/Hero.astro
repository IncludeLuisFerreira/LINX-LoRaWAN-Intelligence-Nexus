---
/**
 * Hero
 * -------------------------------------------------------------
 * Proposta de valor + cena 3D "malha viva" (three.js).
 * - Esfera uniforme de nós (distribuição Fibonacci) = sensores.
 * - Pulsos de dados viajando pelas conexões.
 * - Nuvem LINX no centro; parallax de mouse e rotação lenta.
 * A cena é carregada de forma assíncrona e desligada em
 * prefers-reduced-motion (renderiza um único frame estático).
 */
---

<section class="hero" id="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow" data-reveal>IoT LoRaWAN gerenciado</span>
      <h1 class="hero__title" data-reveal>
        Sensores conectados.<br />Infraestrutura zero.
      </h1>
      <p class="hero__lead" data-reveal>
        A LINX leva os dados dos seus sensores direto para a nuvem, com
        isolamento por aplicação e provisionamento por QR Code. Sem gateways no
        seu site, sem servidores para manter.
      </p>

      <div class="hero__cta" data-reveal>
        <a class="btn btn--primary btn--lg" href="/signup">Ativar plataforma</a>
        <a class="btn btn--outline btn--lg" href="#how">Ver como funciona</a>
      </div>

      <ul class="hero__chips" data-reveal>
        <li><strong>TLS 1.3</strong> ponta a ponta</li>
        <li><strong>Plug and play</strong> em minutos</li>
        <li><strong>RBAC</strong> por aplicação</li>
      </ul>
    </div>

    <div class="hero__scene" aria-hidden="true">
      <canvas id="hero-canvas"></canvas>
      <span class="hero__scene-hint">Mova o mouse — a malha reage</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
        58% 55% at 80% 40%,
        rgba(13, 148, 136, 0.12),
        transparent 70%
      ),
      radial-gradient(46% 46% at 8% 86%, rgba(56, 189, 248, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero__title {
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 54ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    color: var(--color-text-secondary);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__chips li {
    padding: 0.5rem 0.95rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .hero__chips strong {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .hero__scene {
    position: relative;
    height: min(62vh, 560px);
    min-height: 360px;
  }

  #hero-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__scene-hint {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__scene {
      order: -1;
      height: 42vh;
      min-height: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scene-hint {
      display: none;
    }
  }
</style>

<script>
  import type * as ThreeNS from 'three';

  (async () => {
    const canvas = document.querySelector<HTMLCanvasElement>('#hero-canvas');
    if (!canvas) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmall = window.innerWidth < 768;
    const N_DEV = isSmall ? 52 : 92;
    const N_GATE = 6;

    const THREE: typeof ThreeNS = await import('three');

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(46, 1, 0.1, 2000);
    camera.position.set(0, 0, 520);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x000000, 0);

    const group = new THREE.Group();
    scene.add(group);

    const R = 200;

    // --- Nós: nuvem (índice 0), gateways, dispositivos ---
    type Node = { pos: THREE.Vector3; type: 'cloud' | 'gate' | 'dev' };
    const nodes: Node[] = [];
    nodes.push({ pos: new THREE.Vector3(0, 0, 0), type: 'cloud' });

    // Gateways: anel discreto no equador da esfera
    for (let i = 0; i < N_GATE; i++) {
      const a = (i / N_GATE) * Math.PI * 2;
      nodes.push({
        pos: new THREE.Vector3(
          Math.cos(a) * R,
          Math.sin(a) * R * 0.28,
          Math.sin(a) * R,
        ),
        type: 'gate',
      });
    }

    // Dispositivos: esfera Fibonacci (distribuição uniforme)
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N_DEV; i++) {
      const y = 1 - (i / (N_DEV - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = i * golden;
      nodes.push({
        pos: new THREE.Vector3(Math.cos(t) * r * R, y * R, Math.sin(t) * r * R),
        type: 'dev',
      });
    }

    const positions: number[] = [];
    nodes.forEach((n) => positions.push(n.pos.x, n.pos.y, n.pos.z));

    // --- Arestas (arestas: dispositivos próximos + gateway→nuvem) ---
    const edges: [number, number][] = [];
    const devIdx: number[] = [];
    const gateIdx: number[] = [];
    nodes.forEach((n, i) => {
      if (n.type === 'dev') devIdx.push(i);
      if (n.type === 'gate') gateIdx.push(i);
    });

    const KNN = isSmall ? 2 : 2;
    for (const i of devIdx) {
      const near = devIdx
        .filter((j) => j !== i)
        .map((j) => ({ j, d: nodes[i].pos.distanceToSquared(nodes[j].pos) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, KNN);
      for (const { j } of near) {
        const key: [number, number] = i < j ? [i, j] : [j, i];
        if (!edges.some((e) => e[0] === key[0] && e[1] === key[1])) edges.push(key);
      }
    }
    for (const g of gateIdx) edges.push([g, 0]);

    const edgePositions = new Float32Array(edges.length * 6);
    edges.forEach((e, i) => {
      const a = nodes[e[0]].pos;
      const b = nodes[e[1]].pos;
      edgePositions.set([a.x, a.y, a.z, b.x, b.y, b.z], i * 6);
    });
    const edgeGeo = new THREE.BufferGeometry();
    edgeGeo.setAttribute('position', new THREE.BufferAttribute(edgePositions, 3));
    const edgeMat = new THREE.LineBasicMaterial({
      color: 0x0d9488,
      transparent: true,
      opacity: 0.12,
    });
    group.add(new THREE.LineSegments(edgeGeo, edgeMat));

    // --- Pontos dos dispositivos ---
    const devPositions = new Float32Array(devIdx.length * 3);
    devIdx.forEach((idx, i) =>
      devPositions.set([nodes[idx].pos.x, nodes[idx].pos.y, nodes[idx].pos.z], i * 3),
    );
    const devGeo = new THREE.BufferGeometry();
    devGeo.setAttribute('position', new THREE.BufferAttribute(devPositions, 3));
    const devMat = new THREE.PointsMaterial({
      color: 0x0d9488,
      size: 3.2,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.7,
      depthWrite: false,
    });
    group.add(new THREE.Points(devGeo, devMat));

    // --- Nuvem e gateways como esferas ---
    const cloud = new THREE.Mesh(
      new THREE.SphereGeometry(9, 24, 24),
      new THREE.MeshBasicMaterial({ color: 0x0b1f33 }),
    );
    group.add(cloud);
    const halo = new THREE.Mesh(
      new THREE.SphereGeometry(20, 24, 24),
      new THREE.MeshBasicMaterial({
        color: 0x0d9488,
        transparent: true,
        opacity: 0.14,
      }),
    );
    group.add(halo);

    const gateGeo = new THREE.SphereGeometry(4.6, 18, 18);
    const gateMat = new THREE.MeshBasicMaterial({ color: 0x0d9488 });
    for (const g of gateIdx) {
      const m = new THREE.Mesh(gateGeo, gateMat);
      m.position.copy(nodes[g].pos);
      group.add(m);
    }

    // --- Pulsos de dados ---
    const MAX_P = isSmall ? 18 : 34;
    const pulseArr = new Float32Array(MAX_P * 3).fill(9e4);
    const pulseGeo = new THREE.BufferGeometry();
    pulseGeo.setAttribute('position', new THREE.BufferAttribute(pulseArr, 3));
    const pulseMat = new THREE.PointsMaterial({
      color: 0x14b8a6,
      size: 7,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.95,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    group.add(new THREE.Points(pulseGeo, pulseMat));

    const pulses = Array.from({ length: MAX_P }, () => ({
      a: 0,
      b: 0,
      t: 1,
      sp: 0,
    }));
    const spawn = (p: (typeof pulses)[number]) => {
      const e = edges[(Math.random() * edges.length) | 0];
      const rev = Math.random() < 0.5;
      p.a = rev ? e[1] : e[0];
      p.b = rev ? e[0] : e[1];
      p.t = 0;
      p.sp = 0.006 + Math.random() * 0.007;
    };
    pulses.forEach((p) => {
      spawn(p);
      p.t = Math.random();
    });

    // --- Mouse parallax ---
    let tx = 0;
    let ty = 0;
    let cxp = 0;
    let cyp = 0;
    const onPointer = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
    };
    canvas.addEventListener('pointermove', onPointer);
    canvas.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
    });

    // --- Resize ---
    const resize = () => {
      const parent = canvas.parentElement as HTMLElement;
      const w = parent.clientWidth;
      const h = parent.clientHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(dpr);
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    // --- Loop ---
    let visible = true;
    let lastTime = performance.now();

    const render = () => {
      if (reduce) return;
      requestAnimationFrame(render);
      if (!visible || document.hidden) return;

      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;
      cxp += (tx - cxp) * 0.05;
      cyp += (ty - cyp) * 0.05;

      group.rotation.y += dt * 0.14;
      group.rotation.x = cyp * 0.3;
      group.rotation.y += cxp * 0.0025;

      for (let i = 0; i < MAX_P; i++) {
        const p = pulses[i];
        p.t += p.sp * (dt * 60);
        if (p.t >= 1) spawn(p);
        const a = nodes[p.a].pos;
        const b = nodes[p.b].pos;
        pulseArr[i * 3] = a.x + (b.x - a.x) * p.t;
        pulseArr[i * 3 + 1] = a.y + (b.y - a.y) * p.t;
        pulseArr[i * 3 + 2] = a.z + (b.z - a.z) * p.t;
      }
      (pulseGeo.attributes.position as ThreeNS.BufferAttribute).needsUpdate = true;

      renderer.render(scene, camera);
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
      },
      { threshold: 0.01 },
    );
    io.observe(canvas);

    if (reduce) {
      renderer.render(scene, camera); // frame estático
    } else {
      requestAnimationFrame(render);
    }
  })();
</script>
