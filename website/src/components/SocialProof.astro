---
/**
 * SocialProof
 * -------------------------------------------------------------
 * Faixa de confiança: nomes de clientes + métricas com contadores.
 * Dados estão no frontmatter para edição simples.
 */
const customers = ['AGRORA', 'MetalUno', 'RotaCerta', 'AgroVale', 'FrigoNorte'];

const metrics = [
  { value: 98.7, decimals: 1, suffix: '%', label: 'Disponibilidade da plataforma' },
  { value: 12480, decimals: 0, suffix: '', label: 'Sensores provisionados', group: true },
  { value: 35, decimals: 0, suffix: ' ms', label: 'Latência média no push' },
  { value: 99.95, decimals: 2, suffix: '%', label: 'Entrega de uplinks' },
];
---

<section class="proof section--alt">
  <div class="container">
    <p class="proof__label" data-reveal>Confiado por equipes em campo</p>

    <ul class="proof__logos" data-reveal>
      {customers.map((c) => <li>{c}</li>)}
    </ul>

    <div class="proof__metrics">
      {
        metrics.map((m, i) => (
          <div class="proof__metric" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <strong
              data-count={m.value}
              data-decimals={m.decimals}
              data-suffix={m.suffix}
            >
              {m.value.toLocaleString('pt-BR', {
                minimumFractionDigits: m.decimals,
                maximumFractionDigits: m.decimals,
              })}
              {m.suffix}
            </strong>
            <span>{m.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .proof__label {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .proof__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    opacity: 0.6;
    filter: grayscale(1);
  }

  .proof__logos li {
    font-size: clamp(1rem, 2vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .proof__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: 2.5rem;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .proof__metric {
    background: var(--color-surface);
    padding: 1.5rem;
  }

  .proof__metric strong {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .proof__metric span {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .proof__metrics {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
