---
/**
 * Footer
 * -------------------------------------------------------------
 * Rodapé escuro com 4 colunas (marca + Produto/Soluções/Empresa)
 * e barra inferior com copyright e links legais.
 */
type FooterColumn = {
  title: string;
  links: { label: string; href: string }[];
};

const columns: FooterColumn[] = [
  {
    title: 'Produto',
    links: [
      { label: 'Plataforma', href: '#features' },
      { label: 'Como funciona', href: '#how' },
      { label: 'Segurança', href: '#security' },
      { label: 'Status', href: '/status' },
    ],
  },
  {
    title: 'Soluções',
    links: [
      { label: 'Agricultura', href: '#usecases' },
      { label: 'Indústria', href: '#usecases' },
      { label: 'Logística', href: '#usecases' },
      { label: 'Integrações', href: '/docs' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Sobre', href: '/about/' },
      { label: 'Contato', href: '#contact' },
      { label: 'Carreiras', href: '/careers' },
      { label: 'Documentação', href: '/docs' },
    ],
  },
];

const legalLinks = [
  { label: 'Privacidade', href: '/privacy' },
  { label: 'Termos', href: '/terms' },
  { label: 'Cookies', href: '/cookies' },
  { label: 'LGPD', href: '/lgpd' },
];

const socials = [
  { name: 'LinkedIn', href: 'https://linkedin.com/company/linx', icon: 'linkedin' },
  { name: 'GitHub', href: 'https://github.com/linx', icon: 'github' },
  { name: 'X (Twitter)', href: 'https://x.com/linx', icon: 'x' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer" id="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label="LINX — página inicial">
          <span class="footer__mark" aria-hidden="true"></span>
          <span class="footer__name">LIN<span class="footer__x">X</span></span>
        </a>
        <p class="footer__tagline">
          Plataforma IoT LoRaWAN gerenciada. LoRaWAN Intelligence Nexus.
        </p>

        <ul class="socials">
          {
            socials.map((social) => (
              <li>
                <a
                  class="socials__link"
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.name}
                >
                  {social.icon === 'x' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M18.9 2H22l-7.5 8.6L23.3 22h-6.9l-5.4-7-6.2 7H1.7l8-9.1L1 2h7.1l4.9 6.4L18.9 2Zm-1.2 18h1.9L7.4 3.9H5.4L17.7 20Z" />
                    </svg>
                  )}
                  {social.icon === 'github' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M12 2A10 10 0 0 0 8.8 21.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.2-1.5-1.2-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5A3.9 3.9 0 0 1 6.6 8.7a3.6 3.6 0 0 1 .1-2.7s.9-.3 2.8 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.3.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z" />
                    </svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM0 8h5v16H0V8Zm7.5 0h4.8v2.2h.1c.7-1.3 2.3-2.5 4.7-2.5 5 0 5.9 3.3 5.9 7.6V24h-5v-7.6c0-1.8 0-4.1-2.5-4.1s-2.9 2-2.9 4V24h-5V8Z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((column) => (
          <div class="footer__column">
            <h3 class="footer__heading">{column.title}</h3>
            <ul class="footer__links">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer__bottom">
      <p>© {year} LINX. Todos os direitos reservados.</p>
      <nav class="footer__legal" aria-label="Links legais">
        {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #fff;
    padding-block: 4rem 2rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .footer__mark {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-accent);
  }

  .footer__name {
    font-size: 1.375rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.03em;
  }

  .footer__x {
    color: #5eead4;
  }

  .footer__tagline {
    margin: 1rem 0 1.5rem;
    max-width: 280px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    font-size: 0.9375rem;
  }

  .socials {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
    transition: color var(--transition), background var(--transition);
  }

  .socials__link:hover {
    color: var(--color-primary);
    background: #5eead4;
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5eead4;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transition);
  }

  .footer__links a:hover {
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer__legal a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer__legal a:hover {
    color: #fff;
  }

  @media (max-width: 1023px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 639px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
