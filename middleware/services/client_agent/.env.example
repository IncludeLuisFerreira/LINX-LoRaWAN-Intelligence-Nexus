# Dev local: Linx Core acessível na mesma máquina (uvicorn/docker).
SAAS_GRPC_HOST=localhost:50051
# Em container (docker-compose.prod.yml) use o endereço alcançável do SaaS,
# ex.: 10.0.0.5:50051 (IP privado da EC2) ou um alias de rede Docker.
GRPC_TIMEOUT_SECONDS=5
CONFIG_CACHE_TTL_SECONDS=60

# mTLS gRPC (#82). Gere CA e certificados com
# `bash deploy/scripts/gen-grpc-certs.sh` na raiz do repositório.
# Configure os três juntos; com nenhum, o canal volta a ser inseguro (dev).
GRPC_CA_CERT_PATH=../../deploy/certs/grpc/ca/ca.crt
GRPC_CLIENT_CERT_PATH=../../deploy/certs/grpc/client/client.crt
GRPC_CLIENT_KEY_PATH=../../deploy/certs/grpc/client/client.key
