# Dev local: SaaS Backend acessível na mesma máquina (uvicorn/docker).
SAAS_GRPC_HOST=localhost:50051
# Em container (docker-compose.prod.yml) use o endereço alcançável do SaaS,
# ex.: 10.0.0.5:50051 (IP privado da EC2) ou um alias de rede Docker.
GRPC_TIMEOUT_SECONDS=5
CONFIG_CACHE_TTL_SECONDS=60

# Destino da ingestão (tenant_app) e timeout do encaminhamento.
TENANT_APP_URL=http://localhost:8002
INGEST_TIMEOUT_SECONDS=5

# Destino do POST do consumidor MQTT.
INGEST_URL=http://localhost:8001/ingest
