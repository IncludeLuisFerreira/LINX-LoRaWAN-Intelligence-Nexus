POSTGRES_USER=linx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=linx
DATABASE_URL=postgresql+psycopg://linx:change-me-in-production@localhost:5432/linx
DB_CONNECT_TIMEOUT=5
# Token de serviço do plano de controle e da chamada gRPC (mínimo 32 chars).
# Este placeholder é rejeitado no startup; gere o valor real com:
#   openssl rand -hex 32
SERVICE_TOKEN=change-me-in-production

# GID do grupo dono de /var/run/docker.sock no host.
# Descubra com: stat -c '%g' /var/run/docker.sock
DOCKER_GID=990

# Serviço de provisionamento Docker (issue #58).
# Consumido pelo jobs_worker; o identity_api apenas enfileira o job.
# Em modo host use localhost:50052; o Compose sobrescreve para
# docker_provisioner:50052.
PROVISIONER_GRPC_HOST=localhost:50052
PROVISIONER_GRPC_TIMEOUT_SECONDS=10
PROVISION_IMAGE=linx-tenant-app:latest
PROVISION_PORT_MIN=8100
PROVISION_PORT_MAX=9100
PROVISION_BIND_HOST=0.0.0.0
PROVISION_NETWORK_PREFIX=linx-app
PROVISION_CONTAINER_PORT=8000

GRPC_HOST=0.0.0.0
GRPC_PORT=50051
CHIRPSTACK_HOST=localhost:8080
CHIRPSTACK_API_TOKEN=change-me-in-production
CHIRPSTACK_USE_TLS=false
CHIRPSTACK_CA_CERT=

# RabbitMQ: provisionamento de credencial e permissão por tenant.
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_ADMIN_USER=linx
RABBITMQ_ADMIN_PASSWORD=change-me-in-production
RABBITMQ_VHOST=/
RABBITMQ_TENANT_SECRET=change-me-in-production
RABBITMQ_AMQP_HOST=rabbitmq:5672

# Jobs assíncronos (issue #58). O jobs_worker consome a fila de
# provisionamento e publica eventos de status. Troque a senha no
# RABBITMQ_AMQP_URL; o placeholder é rejeitado no startup.
RABBITMQ_AMQP_URL=amqp://linx:change-me-in-production@localhost:5672/
# Fila consumida pelo jobs_worker; deve existir com o mesmo binding/DLX.
WORKER_QUEUE=linx.jobs.provisioning
WORKER_CONCURRENCY=4
WORKER_PREFETCH=4
# Tentativas máximas gravadas no job pelo identity_api na criação.
JOB_MAX_ATTEMPTS=3
# Tentativas de publicação antes de colocar a mensagem da outbox em quarentena.
OUTBOX_MAX_ATTEMPTS=10
JOB_LOCK_SECONDS=60
JOB_REAPER_INTERVAL_SECONDS=60
